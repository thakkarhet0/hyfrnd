# Copy this file to .env.local and fill in your values
# All keys are injected at EAS build time — never commit .env.local

# Anthropic Claude API key (for AI extraction service)
CLAUDE_API_KEY=

# Sarvam AI API key (primary STT provider)
SARVAM_API_KEY=

# ElevenLabs API key (fallback STT provider)
ELEVENLABS_API_KEY=

# PostHog analytics API key
POSTHOG_API_KEY=

# Sentry DSN for crash reporting (public, safe to commit in non-secret form)
# Find in: Sentry dashboard → Project → Settings → Client Keys
SENTRY_DSN=

# Sentry auth token for source map upload (set via: eas secret:create --name SENTRY_AUTH_TOKEN)
# Generate at: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=

# Expo access token for EAS CLI (thakkarhet account)
# Generate at: https://expo.dev/settings/access-tokens
EXPO_TOKEN=
